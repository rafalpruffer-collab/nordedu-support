diff --git a/core/src/LockWidget.cpp b/core/src/LockWidget.cpp
index 419a79c..df4b9c8 100644
--- a/core/src/LockWidget.cpp
+++ b/core/src/LockWidget.cpp
@@ -107,10 +107,15 @@ void LockWidget::paintEvent( QPaintEvent* event )
 		break;
 
 	case BackgroundPixmap:
-		p.fillRect( rect(), QColor( 64, 64, 64 ) );
-		p.drawPixmap( ( width() - m_background.width() ) / 2,
-					  ( height() - m_background.height() ) / 2,
-					  m_background );
+		p.fillRect( rect(), QColor( 23, 42, 84 ) );
+		if( m_background.isNull() == false )
+		{
+			// NordEdu Support: scale the lock screen graphic so it covers the whole screen
+			const auto scaled = m_background.scaled( size(), Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation );
+			p.drawPixmap( ( width() - scaled.width() ) / 2,
+						  ( height() - scaled.height() ) / 2,
+						  scaled );
+		}
 		break;
 
 	default:
